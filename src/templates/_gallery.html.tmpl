<h2>{{ . }}&rarr;</h2>
{{ range (gallery .) }}
  <label class="gallery-item" data-gallery-photo="{{ .WebPath }}">
    <input type="checkbox" />
    {{ $img := . }}
    {{ $downscaled := index .Thumbnails 0 }}
    {{ $fullscreen := . }}
    {{ range .Thumbnails }}
      {{ if le .Height 256 }}
        {{ $downscaled = . }}
      {{ end }}
    {{ end }}
    <img
      alt="{{ $img.Alt }}"
      class="thumbnail"
      src="{{ $downscaled.WebPath }}"
      title=""
    />
    <span class="fullsize fullsize-loading"> loading fullsize </span>
    <img
      alt="{{ $img.Alt }}"
      class="fullsize fullsize-photo"
      decoding="async"
      loading="lazy"
      src="{{ $fullscreen.WebPath }}"
      title=""
    />
    <p class="caption exif">
      {{ with .Camera }}
        <a href="{{ .Link }}" target="_blank">{{ .Make }} {{ .Model }}</a><br />
      {{ end }}
      {{ with .Lens }}
        <a href="{{ .Link }}" target="_blank">{{ .Make }} {{ .Model }}</a>
        @
      {{ end }}
      {{ .FocalLength }}mm &bull;
      ƒ{{ .Aperture }}
      &bull; {{ .ShutterSpeed }}s &bull; ISO
      {{ .ISO }}
      <br />
      &copy; {{ .TakenAt.Year }} Ben Carlsson
      {{ with .PurchaseURL }}
        &bull;
        <a class="muted" href="{{ . }}" target="_blank" rel="noopener">purchase</a>
      {{ end }}
    </p>
  </label>
{{ end }}
