<script
  crossorigin="anonymous"
  defer
  integrity="sha384-X/XCfMm41VSsqRNQgDerQczD69XqmjOOOwYQvr/uuC+j4OPoNhVgjdGFwhvN02Ja"
  src="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/katex.min.js"
></script>
<script
  crossorigin="anonymous"
  defer
  integrity="sha384-+XBljXPPiv+OzfbB3cVmLHf4hdUFHlWNZN5spNQ7rmHTXpd7WvJum6fIACpNNfIR"
  onload="renderMathInElement(document.body);"
  src="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/contrib/auto-render.min.js"
></script>
<script>
  // TODO: Move to static generation
  if (document.location.hostname == "localhost") {
    const wsurl = "ws://localhost:8100/ws";
    const socket = new WebSocket(wsurl);
    socket.addEventListener("message", (event) => location.reload());
    socket.addEventListener("close", (event) => {
      console.log("backup initiating");
      setInterval(() => {
        const sock = new WebSocket("ws://localhost:8100/ws");
        sock.addEventListener("open", (event) => {
          location.reload();
        });
      }, 1000);
    });
  }

  // For Go developers, it's common to access the documentation for a package
  // by navigating to the package's import path in the browser.
  //
  // GitHub Pages allows omitting ".html" from the path when rendering pages,
  // so we'll selectively redirect to the package documentation if and only if
  // ".html" is not present.
  //
  // Therefore, twos.dev/winter.html is the command documentation,
  // and twos.dev/winter is the package documentation.
  if (document.location.pathname === "/winter") {
    window.location.replace("https://pkg.go.dev/twos.dev/winter");
  }

  const galleryHashPrefix = "photo=";
  const galleryInputSelector = ".gallery-item input[type=checkbox]";
  const galleryItemSelector = ".gallery-item";
  const galleryCloseFallbackMs = 30000;
  const galleryLoadTokens = new WeakMap();
  const galleryCloseTimers = new WeakMap();
  let gallerySwapToken = 0;

  function getGalleryPhoto(input) {
    return input.closest(".gallery-item")?.dataset.galleryPhoto;
  }

  function getGalleryItem(input) {
    return input.closest(galleryItemSelector);
  }

  function getGalleryPhotoFromHash() {
    const hash = window.location.hash.slice(1);
    if (!hasGalleryHash()) {
      return null;
    }

    try {
      return decodeURIComponent(hash.slice(galleryHashPrefix.length));
    } catch (_) {
      return null;
    }
  }

  function hasGalleryHash() {
    return window.location.hash.slice(1).startsWith(galleryHashPrefix);
  }

  function findGalleryInput(photo) {
    return Array.from(document.querySelectorAll(".gallery-item"))
      .find((item) => item.dataset.galleryPhoto === photo)
      ?.querySelector("input[type=checkbox]");
  }

  function replaceGalleryHash(hash) {
    window.history.replaceState(
      null,
      "",
      `${window.location.pathname}${window.location.search}${hash}`,
    );
  }

  function syncGalleryHash(input) {
    const photo = getGalleryPhoto(input);
    if (!photo) {
      return;
    }

    replaceGalleryHash(`#${galleryHashPrefix}${encodeURIComponent(photo)}`);
  }

  function clearGalleryHash() {
    if (hasGalleryHash()) {
      replaceGalleryHash("");
    }
  }

  function prefersReducedGalleryMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function setGalleryRectVars(item) {
    const thumbnail = item.querySelector("img.thumbnail");
    if (!thumbnail) {
      return;
    }

    const thumbRect = thumbnail.getBoundingClientRect();
    setGalleryExpandedRectVars(
      item,
      thumbnail.naturalWidth || thumbRect.width || 1,
      thumbnail.naturalHeight || thumbRect.height || 1,
    );

    item.style.setProperty("--gallery-thumb-left", `${thumbRect.left}px`);
    item.style.setProperty("--gallery-thumb-top", `${thumbRect.top}px`);
    item.style.setProperty("--gallery-thumb-width", `${thumbRect.width}px`);
    item.style.setProperty("--gallery-thumb-height", `${thumbRect.height}px`);
  }

  function setGalleryExpandedRectVars(item, naturalWidth, naturalHeight) {
    const scale = Math.min(
      window.innerWidth / naturalWidth,
      window.innerHeight / naturalHeight,
    );
    const expandedWidth = naturalWidth * scale;
    const expandedHeight = naturalHeight * scale;
    const expandedLeft = (window.innerWidth - expandedWidth) / 2;
    const expandedTop = (window.innerHeight - expandedHeight) / 2;

    item.style.setProperty("--gallery-expanded-left", `${expandedLeft}px`);
    item.style.setProperty("--gallery-expanded-top", `${expandedTop}px`);
    item.style.setProperty("--gallery-expanded-width", `${expandedWidth}px`);
    item.style.setProperty("--gallery-expanded-height", `${expandedHeight}px`);
  }

  function clearGalleryCloseTimer(item) {
    const cleanup = galleryCloseTimers.get(item);
    if (cleanup) {
      cleanup();
      galleryCloseTimers.delete(item);
    }
  }

  function resetGalleryItem(item) {
    clearGalleryCloseTimer(item);
    item.classList.remove(
      "is-active",
      "is-animating",
      "is-backdrop-visible",
      "is-closing",
      "is-expanded",
      "is-loaded",
      "is-loading",
      "is-motion-fullsize",
      "is-settled",
    );
    galleryLoadTokens.delete(item);
  }

  function waitForGalleryFullsize(item) {
    const fullsize = item.querySelector("img.fullsize-photo");
    if (!fullsize) {
      return Promise.resolve();
    }

    fullsize.loading = "eager";

    if (fullsize.complete && fullsize.naturalWidth > 0) {
      return fullsize.decode
        ? fullsize.decode().catch(() => {})
        : Promise.resolve();
    }

    if (fullsize.decode) {
      return fullsize.decode().catch(
        () =>
          new Promise((resolve) => {
            const done = () => {
              fullsize.removeEventListener("load", done);
              fullsize.removeEventListener("error", done);
              resolve();
            };
            fullsize.addEventListener("load", done);
            fullsize.addEventListener("error", done);
          }),
      );
    }

    return new Promise((resolve) => {
      const done = () => {
        fullsize.removeEventListener("load", done);
        fullsize.removeEventListener("error", done);
        resolve();
      };
      fullsize.addEventListener("load", done);
      fullsize.addEventListener("error", done);
    }).then(() =>
      fullsize.decode ? fullsize.decode().catch(() => {}) : Promise.resolve(),
    );
  }

  function getGalleryMotionElement(item) {
    if (item.classList.contains("is-motion-fullsize")) {
      return item.querySelector("img.fullsize-photo");
    }

    return item.querySelector("img.thumbnail");
  }

  function isGalleryFullsizeReady(item) {
    const fullsize = item.querySelector("img.fullsize-photo");
    return Boolean(fullsize?.complete && fullsize.naturalWidth > 0);
  }

  function waitForGalleryMotionTransition(item) {
    if (prefersReducedGalleryMotion()) {
      return Promise.resolve();
    }

    const motionElement = getGalleryMotionElement(item);
    if (!motionElement) {
      return Promise.resolve();
    }

    return new Promise((resolve) => {
      let didResolve = false;
      const pendingProperties = new Set(["height", "left", "top", "width"]);
      const resolveOnce = () => {
        if (didResolve) {
          return;
        }

        didResolve = true;
        motionElement.removeEventListener("transitionend", onTransitionEnd);
        window.clearTimeout(fallback);
        resolve();
      };
      const onTransitionEnd = (event) => {
        if (event.target !== motionElement) {
          return;
        }

        pendingProperties.delete(event.propertyName);
        if (pendingProperties.size === 0) {
          resolveOnce();
        }
      };
      const fallback = window.setTimeout(resolveOnce, galleryCloseFallbackMs);

      motionElement.addEventListener("transitionend", onTransitionEnd);
    });
  }

  function openGalleryInput(input, updateHash = true) {
    const item = getGalleryItem(input);
    if (!item) {
      return;
    }

    const current = document.querySelector(".gallery-item input:checked");
    if (current && current !== input) {
      closeGalleryInput(current, false, false);
    }

    clearGalleryCloseTimer(item);
    setGalleryRectVars(item);
    input.checked = true;
    item.classList.remove(
      "is-animating",
      "is-backdrop-visible",
      "is-closing",
      "is-loaded",
      "is-motion-fullsize",
      "is-settled",
    );
    if (isGalleryFullsizeReady(item)) {
      item.classList.add("is-motion-fullsize");
    }

    item.classList.add("is-active", "is-loading");

    if (updateHash) {
      syncGalleryHash(input);
    }

    const loadToken = Symbol("gallery-load");
    galleryLoadTokens.set(item, loadToken);

    requestAnimationFrame(() => {
      if (!input.checked || !item.classList.contains("is-active")) {
        return;
      }

      const zoomReady = waitForGalleryMotionTransition(item);
      item.classList.add("is-animating", "is-backdrop-visible", "is-expanded");
      zoomReady.then(() => {
        if (galleryLoadTokens.get(item) !== loadToken) {
          return;
        }

        item.classList.add("is-settled");
      });

      waitForGalleryFullsize(item).then(() => {
        if (galleryLoadTokens.get(item) !== loadToken) {
          return;
        }

        item.classList.remove("is-loading");
        item.classList.add("is-loaded");
      });
    });
  }

  function prepareGalleryFullscreenItem(
    item,
    showBackdrop = true,
    updateRects = true,
  ) {
    clearGalleryCloseTimer(item);
    if (updateRects) {
      setGalleryRectVars(item);
    }
    item.classList.remove(
      "is-animating",
      "is-backdrop-visible",
      "is-closing",
      "is-loading",
      "is-motion-fullsize",
    );
    item.classList.add(
      "is-active",
      "is-expanded",
      "is-loaded",
      "is-settled",
    );
    if (showBackdrop) {
      item.classList.add("is-backdrop-visible");
    }
    if (isGalleryFullsizeReady(item)) {
      item.classList.add("is-motion-fullsize");
    }
  }

  function prepareGalleryLoadingItem(item, showBackdrop = true) {
    clearGalleryCloseTimer(item);
    item.classList.remove(
      "is-animating",
      "is-backdrop-visible",
      "is-closing",
      "is-loaded",
      "is-motion-fullsize",
    );
    item.classList.add(
      "is-active",
      "is-expanded",
      "is-loading",
      "is-settled",
    );
    if (showBackdrop) {
      item.classList.add("is-backdrop-visible");
    }
  }

  function replaceGalleryInput(fromInput, toInput) {
    const fromItem = getGalleryItem(fromInput);
    const toItem = getGalleryItem(toInput);
    if (!fromItem || !toItem || fromItem === toItem) {
      return;
    }

    const swapToken = ++gallerySwapToken;
    galleryLoadTokens.delete(fromItem);
    clearGalleryCloseTimer(fromItem);

    setGalleryRectVars(toItem);
    const targetAlreadyReady = isGalleryFullsizeReady(toItem);
    const loadToken = Symbol("gallery-load");
    galleryLoadTokens.set(toItem, loadToken);

    fromInput.checked = false;
    toInput.checked = true;
    syncGalleryHash(toInput);

    if (targetAlreadyReady) {
      prepareGalleryFullscreenItem(toItem, true, false);
    } else {
      prepareGalleryLoadingItem(toItem);
    }

    resetGalleryItem(fromItem);

    if (!targetAlreadyReady) {
      waitForGalleryFullsize(toItem).then(() => {
        if (
          swapToken !== gallerySwapToken ||
          galleryLoadTokens.get(toItem) !== loadToken ||
          !toInput.checked ||
          !toItem.classList.contains("is-active")
        ) {
          return;
        }

        toItem.classList.remove("is-loading");
        toItem.classList.add("is-loaded");
      });
    }
  }

  function closeGalleryInput(input, updateHash = true, animate = true) {
    const item = getGalleryItem(input);
    if (!item) {
      return;
    }

    gallerySwapToken += 1;
    input.checked = false;
    galleryLoadTokens.delete(item);

    if (updateHash) {
      clearGalleryHash();
    }

    if (!animate || prefersReducedGalleryMotion()) {
      resetGalleryItem(item);
      return;
    }

    if (isGalleryFullsizeReady(item)) {
      item.classList.add("is-motion-fullsize");
    }

    const motionElement = getGalleryMotionElement(item);
    if (!motionElement) {
      resetGalleryItem(item);
      return;
    }

    clearGalleryCloseTimer(item);
    let didReset = false;
    let fallback = null;
    const transitionProperties = new Set(["height", "left", "top", "width"]);
    const resetOnce = () => {
      if (didReset) {
        return;
      }

      didReset = true;
      if (fallback) {
        window.clearTimeout(fallback);
      }
      motionElement.removeEventListener("transitionend", onTransitionEnd);
      requestAnimationFrame(() => {
        requestAnimationFrame(() => resetGalleryItem(item));
      });
    };
    const onTransitionEnd = (event) => {
      if (
        event.target === motionElement &&
        transitionProperties.has(event.propertyName)
      ) {
        resetOnce();
      }
    };

    galleryCloseTimers.set(item, () => {
      if (fallback) {
        window.clearTimeout(fallback);
      }
      motionElement.removeEventListener("transitionend", onTransitionEnd);
    });

    item.classList.add("is-animating");
    motionElement.getBoundingClientRect();
    motionElement.addEventListener("transitionend", onTransitionEnd);
    item.classList.remove(
      "is-expanded",
      "is-loaded",
      "is-loading",
      "is-settled",
      "is-backdrop-visible",
    );
    item.classList.add("is-closing");

    fallback = window.setTimeout(resetOnce, galleryCloseFallbackMs);

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (!motionElement.getAnimations) {
          return;
        }

        const animations = motionElement
          .getAnimations()
          .filter((animation) => animation.playState !== "finished");
        if (animations.length === 0) {
          resetOnce();
          return;
        }

        Promise.allSettled(
          animations.map((animation) => animation.finished),
        ).then(resetOnce);
      });
    });
  }

  function syncGalleryFromHash() {
    const input = findGalleryInput(getGalleryPhotoFromHash());
    const current = document.querySelector(".gallery-item input:checked");

    if (input) {
      openGalleryInput(input, false);
    } else if (current) {
      closeGalleryInput(current, false);
    }
  }

  document.addEventListener("click", (event) => {
    const item = event.target.closest?.(galleryItemSelector);
    if (!item || event.target.closest?.(".caption a")) {
      return;
    }

    const input = item.querySelector("input[type=checkbox]");
    if (!input) {
      return;
    }

    event.preventDefault();

    if (input.checked || item.classList.contains("is-active")) {
      closeGalleryInput(input);
    } else {
      openGalleryInput(input);
    }
  });

  document.addEventListener("change", (event) => {
    const input = event.target.closest?.(galleryInputSelector);
    if (!input) {
      return;
    }

    if (input.checked) {
      openGalleryInput(input);
    } else {
      closeGalleryInput(input);
    }
  });

  window.addEventListener("hashchange", syncGalleryFromHash);
  syncGalleryFromHash();

  // Change lightbox photo using arrow keys.
  document.addEventListener("keydown", (event) => {
    switch (event.key) {
      case "ArrowLeft":
        const moveLeftFrom = document.querySelector(
          ".gallery-item input:checked",
        );
        const moveLeftTo =
          document.querySelector(
            ".gallery-item:has(+ .gallery-item input:checked) input[type=checkbox]",
          ) ??
          document.querySelector(
            ".gallery-item:has(+ h2 + .gallery-item input:checked) input[type=checkbox]",
          );
        if (moveLeftTo) {
          event.preventDefault();
          replaceGalleryInput(moveLeftFrom, moveLeftTo);
        } else if (moveLeftFrom) {
          event.preventDefault();
          closeGalleryInput(moveLeftFrom);
        }
        break;
      case "ArrowRight":
        const moveRightFrom = document.querySelector(
          ".gallery-item input:checked",
        );
        const moveRightTo =
          document.querySelector(
            ".gallery-item:has(input:checked) + .gallery-item input[type=checkbox]",
          ) ??
          document.querySelector(
            ".gallery-item:has(input:checked) + h2 + .gallery-item input[type=checkbox]",
          );
        if (moveRightTo) {
          event.preventDefault();
          replaceGalleryInput(moveRightFrom, moveRightTo);
        } else if (moveRightFrom) {
          event.preventDefault();
          closeGalleryInput(moveRightFrom);
        }
        break;
      case " ": // space
      case "Escape":
        const current = document.querySelector(".gallery-item input:checked");
        if (current) {
          event.preventDefault();
          closeGalleryInput(current);
        }
        break;
    }
  });
</script>
